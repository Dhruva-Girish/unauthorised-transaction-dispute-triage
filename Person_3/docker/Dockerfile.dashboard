# Dockerfile for Person 3 Streamlit Operational Dashboard
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY Person_3/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy source trees
COPY shared_contracts/ /app/shared_contracts/
COPY Person_1/ /app/Person_1/
COPY Person_2/ /app/Person_2/
COPY Person_3/ /app/Person_3/

ENV PYTHONPATH="/app:/app/Person_3:/app/Person_2:/app/Person_1:/app/shared_contracts"
ENV STREAMLIT_SERVER_PORT=8501
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "Person_3/dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
