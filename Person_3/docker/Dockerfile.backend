# Dockerfile for Person 3 FastAPI Backend & gRPC Server
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY Person_3/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code and contracts
COPY shared_contracts/ /app/shared_contracts/
COPY Person_1/ /app/Person_1/
COPY Person_2/ /app/Person_2/
COPY Person_3/ /app/Person_3/

ENV PYTHONPATH="/app:/app/Person_3:/app/Person_2:/app/Person_1:/app/shared_contracts"
ENV PORT=8000
ENV GRPC_PORT=50051

EXPOSE 8000 50051

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["python", "-m", "uvicorn", "Person_3.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
